{
  "id": "D07",
  "title": "Story shear down the building: Same, Split %, Ends, group at one level",
  "intent": "Roof line A is resisted at the roof (hillside). Roof line E lands between 2nd-floor lines C and D (vertical discontinuity) and is split 25 / 75 %. C and D are combined at the 2nd floor only, and that group lands on line E at the 1st floor (100 %). Story shears must add up level by level.",
  "covers": [
    "Ends here",
    "Split %",
    "Group at some levels only",
    "D7: ΣV = ΣF − resisted above"
  ],
  "handCalc": [
    {
      "step": 1,
      "text": "Roof: ΣA = 800 sf, q = 0.01, w = 200 plf → 2.0 k at each end: R.A 2.0, R.B 4.0, R.E 2.0. R.A ends at the roof."
    },
    {
      "step": 2,
      "text": "2nd: ΣA = 400 sf, q = 0.01, w = 100 plf → 1.0 k at each end: own B 1.0, C 1.0, D 1.0, E 1.0."
    },
    {
      "step": 3,
      "text": "2nd story shear: 2.B = 1.0 + R.B 4.0 = 5.0; 2.C+2.D = 2.0 + R.E (25 % + 75 %) 2.0 = 4.0; 2.E = 1.0 (R.E went to C / D). ΣV = 10.0 = 8 + 4 − 2 (R.A)."
    },
    {
      "step": 4,
      "text": "1st: ΣA = 300 sf, q = 0.01, w = 100 plf → 1.5 k each: 1.B = 1.5 + 5.0 = 6.5; 1.E = 1.5 + 2.E 1.0 + (2.C+2.D) 4.0 = 6.5. ΣV = 13.0 = 15 − 2."
    }
  ],
  "expect": [
    {
      "label": "R.A ends at the roof",
      "at": "line:E-W/R.A",
      "field": "ends",
      "value": true,
      "step": 1
    },
    {
      "label": "2.B V (k)",
      "at": "line:E-W/2.B",
      "field": "V",
      "value": 5,
      "step": 3
    },
    {
      "label": "2.C+2.D V (k)",
      "at": "line:E-W/2.C+2.D",
      "field": "V",
      "value": 4,
      "step": 3
    },
    {
      "label": "2.E V (k)",
      "at": "line:E-W/2.E",
      "field": "V",
      "value": 1,
      "step": 3
    },
    {
      "label": "2nd ΣV (k)",
      "at": "level:E-W/2nd Floor",
      "field": "sumV",
      "value": 10,
      "step": 3
    },
    {
      "label": "1.B V (k)",
      "at": "line:E-W/1.B",
      "field": "V",
      "value": 6.5,
      "step": 4
    },
    {
      "label": "1.E V (k)",
      "at": "line:E-W/1.E",
      "field": "V",
      "value": 6.5,
      "step": 4
    },
    {
      "label": "1st ΣV (k)",
      "at": "level:E-W/1st Floor",
      "field": "sumV",
      "value": 13,
      "step": 4
    }
  ],
  "expectChecks": {
