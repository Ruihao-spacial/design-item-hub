    "Whole-overhang uniform",
    "Reversing reaction"
  ],
  "handCalc": [
    {
      "step": 1,
      "text": "Method 1: R1 = −w·a²/(2l) = −0.1 × 25 / 40 = −0.0625; R2 = w·a(2l + a)/(2l) = 0.1 × 5 × 45 / 40 = 0.5625 k."
    },
    {
      "step": 2,
      "text": "Method 2: W = 0.5 k at 22.5 → R2 = 0.5 × 22.5 / 20 = 0.5625; R1 = 0.5 − 0.5625 = −0.0625 k."
    }
  ],
